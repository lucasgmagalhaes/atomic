{
  // Editor-only (see atomic.d.ts's own note) — no Node/npm build step
  // reads this. Its only job is telling VS Code's TS language service
  // that every .js file under this folder belongs to ONE JS project, so
  // ambient globals declared in a .d.ts anywhere in this tree (atomic.d.ts
  // here, lib/ui.d.ts in the subfolder) are visible while editing any
  // bundle .js file — without this, VS Code's implicit/inferred project
  // for a loose .js file doesn't reliably reach into sibling subfolders,
  // which is why lib/ui.js's globals (El/Button/Div/...) weren't showing
  // up while editing toolbar.js/settings.js/etc one directory up.
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "allowJs": true,
    "checkJs": false
  },
  "include": ["**/*.js", "**/*.d.ts"]
}
