{
  // Formats the workspace's only non-Rust source: crates/atomic's chrome
  // bundles (HTML/CSS/JS). Rust itself is formatted by `cargo fmt`
  // (rustfmt.toml), not dprint.
  //
  // `plugins` below were populated by `dprint config add <name>` (each
  // entry is dprint's own pinned name@version + checksum, not hand-typed -
  // safer than guessing one). If this ever needs redoing (e.g. bumping a
  // plugin version), reinstall with:
  //
  //   cargo install dprint
  //   dprint config add g-plane/malva        (CSS)
  //   dprint config add g-plane/markup_fmt    (HTML)
  //   dprint config add typescript            (also covers plain JS)
  //
  // (dprint 0.57's plugin registry renamed the old "css"/"markup" short
  // names to `g-plane/malva`/`g-plane/markup_fmt` - `dprint config add css`
  // alone now errors "could not find plugin"; use the full names above.)
  // After that, `dprint fmt` formats and `dprint check` verifies (the
  // pre-commit hook at .cargo-husky/hooks/pre-commit runs the latter, and
  // only if `dprint` is on PATH).
  "plugins": [
    "npm:@dprint/typescript@0.96.1",
    "npm:dprint-plugin-malva@0.16.0",
    "npm:dprint-plugin-markup@0.27.3"
  ],
  "includes": ["crates/atomic/chrome-ui/**/*.{html,css,js}"],
  "excludes": ["target/**", "graphify-out/**", "**/node_modules/**"]
}
